    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 13,
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": ["sum"]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(magure_errors_total[5m])) by (module) or vector(0)",
          "legendFormat": "{{module}}",
          "refId": "A"
        }
      ],
      "title": "Error Rate by Module",
      "type": "timeseries"
    }
