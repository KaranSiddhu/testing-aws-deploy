{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 101,
      "panels": [],
      "title": "\u2699\ufe0f Workflow Engine",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 4,
        "y": 14
      },
      "id": 6,
      "options": {
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(magure_execution_completed_total{status=\"completed\"}[1h])) or vector(0)) / ((sum(rate(magure_execution_completed_total[1h])) > 0) or vector(1))",
          "refId": "A"
        }
      ],
      "title": "Success Rate",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": ["mean", "last"]
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(magure_execution_started_total[5m])) or vector(0)) * 60",
          "legendFormat": "Started/min",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(magure_execution_completed_total[5m])) or vector(0)) * 60",
          "legendFormat": "Completed/min",
          "refId": "B"
        }
      ],
      "title": "Execution Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": ["mean", "last"]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(magure_execution_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(magure_execution_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "legendFormat": "P50",
          "refId": "B"
        }
      ],
      "title": "Execution Duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 18
      },
      "id": 9,
      "options": {
        "colorMode": "background",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "(sum(rate(magure_execution_completed_total{status=\"failed\"}[5m])) or vector(0)) * 300",
          "refId": "A"
        }
      ],
      "title": "Failed (5m)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 102,
      "panels": [],
      "title": "\ud83d\udd0c MCP Tools",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "UNHEALTHY"
                },
                "1": {
                  "color": "green",
                  "text": "HEALTHY"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "id": 10,
      "options": {
        "colorMode": "background",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "min(magure_mcp_server_health) or vector(1)",
          "refId": "A"
        }
      ],
      "title": "MCP Health",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 23
      },
      "id": 11,
      "options": {
        "colorMode": "value",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(magure_mcp_connection_active) or vector(0)",
          "refId": "A"
        }
      ],
      "title": "Active Connections",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 12,
      "options": {
        "legend": {
          "displayMode": "table",
          "calcs": ["mean", "last"]
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(magure_mcp_tool_calls_total[5m])) by (tool_name)) or vector(0)",
          "legendFormat": "{{tool_name}}",
          "refId": "A"
        }
      ],
      "title": "Top MCP Tools",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "id": 103,
      "panels": [],
