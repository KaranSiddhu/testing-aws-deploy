# Copy to env.sh (gitignored) and fill in. apply.sh sources this file and
# renders every *.tpl manifest with it.
#
#     cp env.sh.example env.sh
#     $EDITOR env.sh
#     ./apply.sh
#
# THE POINT OF THIS FILE: the SHAPE of the configuration is committed, the
# VALUES are not. Anyone cloning the repo can see exactly what they need to
# supply, without a single secret being in git. Same idea as .env.example in
# the app repo, and the same pattern every Magure deployment repo uses.
#
# From Phase 6 most of these will come from `terraform output` instead of being
# typed by hand.

# --- Core -------------------------------------------------------------------
export NS="dummy-hello"

# --- Database ---------------------------------------------------------------
# Phase 5: an in-cluster Postgres, so we choose the password.
# Phase 7: RDS, so these come from `terraform output` and ONLY these lines
#          change. The charts do not.
export POSTGRES_USER="hello"
export POSTGRES_PASSWORD="REPLACE_ME"
export POSTGRES_DB="hello"
#
# POSTGRES_PASSWORD_ENCODED is derived automatically by apply.sh. Do not set it.
# It is the URL-encoded form, needed because DATABASE_URL is a URL: a password
# containing @ : / ? # & silently truncates the connection string otherwise,
# and the error you get is "could not translate host name", which sends you
# looking at DNS.

# --- Ingress hostnames ------------------------------------------------------
# localtest.me is a real public domain whose every subdomain resolves to
# 127.0.0.1, so this needs no /etc/hosts editing and no DNS setup.
#
# Port 8080 comes from kind/cluster.yaml, which maps host 8080 to node port 80.
#
# In Phase 7 these become real DNS names in front of an AWS ALB.
export APP_HOST="dummy-hello.localtest.me"
export ARGOCD_HOST="argocd.localtest.me"

# --- Pinned versions --------------------------------------------------------
# Pinned, never "latest" or "stable". A bootstrap that installs a different
# version depending on the day it runs is not a bootstrap, it is a lottery -
# and Phase 8 (rebuild from zero) is meaningless if the result varies.
export ARGOCD_VERSION="v3.5.1"

# ingress-nginx was RETIRED by the Kubernetes project on 2026-03-23. The repo is
# archived: no more releases and no security patches ever. controller-v1.15.1 is
# the final release.
#
# Used here anyway, for two reasons: this cluster is local-only with no internet
# exposure, and trinity/neo still run it in production, so it is what you will
# actually meet at work. Phase 7 uses the AWS Load Balancer Controller instead -
# which is exactly why magoneai-awnic-deploy switched, and its README says so.
#
# The Ingress RESOURCE is not retired. Only this controller is. What you learn
# in 07-routes transfers unchanged.
export INGRESS_NGINX_VERSION="controller-v1.15.1"
