# Copy to env.sh (gitignored) and fill in. apply.sh sources this file and
# renders every *.tpl manifest with it.
#
#     cp env.sh.example env.sh
#     $EDITOR env.sh
#     ./apply.sh
#
# THE POINT OF THIS FILE: the SHAPE of the configuration is committed, the
# VALUES are not. Anyone cloning the repo can see exactly what they need to
# supply, without a single secret being in git. Same idea as .env.example in the
# app repo, and the same pattern every Magure deployment repo uses.


# =============================================================================
# WHICH TARGET
# =============================================================================
# kind  a free three-node cluster on your Mac. In-cluster Postgres, Docker Hub
#       images, ingress-nginx, reachable at *.localtest.me:8080
#
# eks   real AWS. RDS, ECR images, AWS Load Balancer Controller, reachable at
#       your real hostnames over HTTPS. About $4/day while it exists.
#
# This one variable decides which ArgoCD environment directory the root
# Application watches (k8s/argocd/envs/<PLATFORM>) and which ingress template
# apply.sh renders.
export PLATFORM="kind"


# =============================================================================
# CORE
# =============================================================================
export NS="dummy-hello"


# =============================================================================
# DATABASE
# =============================================================================
# PLATFORM=kind : you choose these; the postgres chart creates a database with
#                 them, and DATABASE_URL is assembled by apply.sh.
#
# PLATFORM=eks  : these come from Terraform. Run in terraform/aws/30-data:
#
#                     terraform output db_username
#                     terraform output db_name
#                     terraform output -raw db_password
#
#                 Or skip the assembly entirely and paste the ready-made URL:
#
#                     terraform output -raw database_url
#
#                 into DATABASE_URL_OVERRIDE below.
#
# NOTE the RDS values change every time you recreate the database, because the
# password is generated fresh. That is deliberate: a password that survives a
# rebuild is a password living somewhere it should not.
export POSTGRES_USER="hello"
export POSTGRES_PASSWORD="REPLACE_ME"
export POSTGRES_DB="hello"

# Leave EMPTY on kind. apply.sh then builds the URL from the three values above,
# pointing at the in-cluster postgres Service.
#
# On eks, paste `terraform output -raw database_url` here. It already contains
# the RDS hostname, the URL-encoded password and ?sslmode=require - RDS enforces
# TLS and refuses the connection without it.
export DATABASE_URL_OVERRIDE=""


# =============================================================================
# HOSTNAMES
# =============================================================================
# kind: localtest.me is a real public domain whose every subdomain resolves to
#       127.0.0.1, so it needs no /etc/hosts editing. Port 8080 comes from
#       kind/cluster.yaml.
#
# eks:  your real subdomains, matching terraform/aws/50-edge/terraform.tfvars.
#       They must match, or the certificate will not cover the hostname and
#       every request fails TLS.
export APP_HOST="dummy-hello.localtest.me"
export API_HOST="api-dummy-hello.localtest.me"
export ARGOCD_HOST="argocd.localtest.me"

# For eks, use:
#   export APP_HOST="hello.karansiddhu.com"
#   export API_HOST="api-hello.karansiddhu.com"


# =============================================================================
# EKS ONLY
# =============================================================================
# The ACM certificate the ALB terminates TLS with. From terraform/aws/50-edge:
#
#     terraform output -raw certificate_arn
#
# 50-edge is never destroyed, so this value is stable across sessions. Ignored
# entirely when PLATFORM=kind.
export CERT_ARN=""


# =============================================================================
# PINNED VERSIONS
# =============================================================================
# Deliberately NOT here.
#
# ArgoCD is pinned in 10-argocd/kustomization.yaml, ingress-nginx in
# 06-ingress/kustomization.yaml, and the AWS Load Balancer Controller in
# k8s/argocd/envs/eks/aws-load-balancer-controller.yaml - because kustomize and
# ArgoCD both resolve those references before any variable substitution could
# happen. A $VAR there is taken literally, so putting versions here would be an
# indirection that silently does not work.
#
# All are pinned to exact versions, never "latest" or "stable". A bootstrap that
# installs a different version depending on the day it runs is not a bootstrap,
# and Phase 8 (rebuild from zero) means nothing if the result varies.
