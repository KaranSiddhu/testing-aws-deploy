# Terraform
.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
# .terraform.lock.hcl is intentionally COMMITTED (pins provider versions)
# terraform.tfvars IS committed here: concrete, non-secret config.
# Secrets never live in it — they come via .env / TF_VAR_.

# Secrets — never commit
.env
.secrets/
*-root-token*
vault-init*.json
vault-keys.json
*.rendered.yaml

# Local cluster / OS
kubeconfig*
.DS_Store

# Per-account, generated by bin/init-account.sh (contains the account-specific bucket)
terraform/infra/backend.hcl
