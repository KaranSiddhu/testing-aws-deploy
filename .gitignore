# Secrets. Never commit any of these.
env.sh
*.env
kubeconfig
*-credentials.json
vault-keys.json
*.pem
*.key

# Terraform. State can contain plaintext secrets (database passwords, keys) and
# is stored remotely, never in git.
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars.local
generated/

# Rendered .tpl outputs are ignored by k8s/k8s-config/.gitignore, which lists
# them one by one.
#
# A glob was tried here first and was wrong: `k8s/k8s-config/**/*.yaml` also
# matches kustomization.yaml, which MUST be committed. Listing each rendered
# file explicitly, as trinity does, makes that impossible to get wrong.

# OS / editor
.DS_Store
*.swp
