# Copy to .env (gitignored) and fill in. Every bin/* script auto-sources it:
#   set -a; [ -f .env ] && . ./.env; set +a
# Fill once — you never need to `export` these by hand again.

# --- AWS credentials (target account admin) ---
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1

# --- Docker Hub pull token ---
# login user: magureme   |   image namespace: magureai/*
TF_VAR_docker_token=dckr_pat_REPLACE_ME

# --- Superadmin login (email + password — the platform admin credential pair) ---
TF_VAR_superadmin_email=you@example.com
# Password: set a known value, or leave blank to auto-generate (read via bin/creds.sh).
TF_VAR_superadmin_password=

# --- Grafana admin password (decoupled from superadmin) ---
# Leave blank to auto-generate.
TF_VAR_grafana_admin_password=

# --- Admin access (EKS API endpoint + Grafana IP allowlist) ---
# Your office/VPN CIDR, e.g. 203.0.113.4/32. Comma-separate for multiple.
TF_VAR_admin_cidrs=REPLACE_ME/32

# --- Transactional email (Resend) — optional ---
# Leave unset to boot without sending; set to enable welcome/system emails.
# TF_VAR_email_api_key=re_...
